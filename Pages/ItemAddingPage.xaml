<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Quickly.Pages.ItemAddingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Quickly.Pages.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:models="clr-namespace:Quickly.Models"
    xmlns:pageModels="clr-namespace:Quickly.PageModels"
    xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="pageModels:ItemAddingPageModel"
    BackgroundColor="#F3F3F3">


    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" Margin="15,15,15,0">
            <Button
                BackgroundColor="#F3F3F3"
                Command="{Binding GoBackCommand}"
                HorizontalOptions="Start"
                ImageSource="back_icon.png"
                IsEnabled="True"
                ZIndex="1" />
            <Image
                Aspect="AspectFit"
                HeightRequest="35"
                HorizontalOptions="Center"
                Source="background_logo.png"
                VerticalOptions="Center" />

            <Label
                BackgroundColor="Transparent"
                FontFamily="LibreBaskerville-Bold"
                FontSize="25"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                LineHeight="1.01"
                Text="Quickly&#10;Add Item"
                TextColor="#C0372F" />
        </Grid>

        <StackLayout
            Grid.Row="1"
            Padding="0,10,0,20"
            HorizontalOptions="Center"
            VerticalOptions="Start">
            <Border
                Padding="12,0,10,0"
                Background="White"
                HeightRequest="40"
                HorizontalOptions="Center"
                MinimumWidthRequest="180"
                Stroke="#18000000"
                StrokeShape="RoundRectangle 10, 10, 10, 10"
                StrokeThickness="1.2">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Entry
                        x:Name="SearchEntry"
                        FontFamily="Roboto"
                        FontSize="10"
                        HorizontalOptions="Fill"
                        Placeholder="Search"
                        PlaceholderColor="#838383"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        TextColor="#838383"
                        VerticalOptions="Center" />
                    <Image
                        Grid.Column="1"
                        HeightRequest="13"
                        HorizontalOptions="Center"
                        Source="search_icon.png"
                        VerticalOptions="Center"
                        WidthRequest="13" />
                </Grid>
            </Border>
        </StackLayout>


        <CollectionView
            Grid.Row="2"
            Margin="20,0"
            HorizontalOptions="Fill"
            ItemsSource="{Binding Suggestions}"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="20"
                    Orientation="Vertical"
                    Span="2"
                    VerticalItemSpacing="30" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Item">
                    <Grid
                        HorizontalOptions="Fill"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="10">
                        <controls:SquareView Grid.Row="0" HorizontalOptions="Fill">
                            <Border
                                Padding="0"
                                StrokeShape="RoundRectangle 15,15,15,15"
                                StrokeThickness="0">
                                <Image
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill"
                                    Source="{Binding Image}"
                                    VerticalOptions="Fill">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddInventoryCommand, Source={RelativeSource AncestorType={x:Type pageModels:ItemAddingPageModel}}, x:DataType=pageModels:ItemAddingPageModel}" CommandParameter="{Binding .}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Border>
                        </controls:SquareView>

                        <Label
                            Grid.Row="1"
                            FontFamily="LibreBaskerville-Regular"
                            FontSize="12"
                            HorizontalOptions="Center"
                            LineBreakMode="WordWrap"
                            LineHeight="1.0"
                            MaxLines="2"
                            Text="{Binding Name}"
                            TextColor="#000000"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
